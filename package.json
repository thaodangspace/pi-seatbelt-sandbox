{
  "name": "pi-seatbelt-sandbox",
  "version": "0.1.2",
  "description": "macOS Seatbelt sandbox extension package for pi bash and file-tool access controls.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "seatbelt",
    "sandbox",
    "macos"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thaodangspace/pi-seatbelt-sandbox.git"
  },
  "bugs": {
    "url": "https://github.com/thaodangspace/pi-seatbelt-sandbox/issues"
  },
  "homepage": "https://github.com/thaodangspace/pi-seatbelt-sandbox#readme",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "vitest --run --pool=threads",
    "test:unit": "vitest --run --pool=threads --exclude test/integration.sandbox.test.ts",
    "test:integration": "vitest --run --pool=threads test/integration.sandbox.test.ts",
    "test:package": "node scripts/package-smoke.mjs",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE",
    "RELEASE.md"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.0 <1"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.0 <1",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.0.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
